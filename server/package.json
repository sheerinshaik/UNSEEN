{
  "name": "unseen-server",
  "version": "1.0.0",
  "description": "UNSEEN backend API server with strong identity separation and privacy controls",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
