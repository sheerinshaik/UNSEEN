# UNSEEN Environment Variables Configuration

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/unseen

# Cryptographic Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_with_strong_random_jwt_secret_minimum_32_characters_for_prod
SESSION_SECRET=replace_with_strong_random_session_secret_minimum_32_characters

# Cookie Security (set to true in production behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Initial Admin Bootstrap (Optional default credentials for local bootstrap script)
BOOTSTRAP_ADMIN_EMAIL=admin@unseen.internal
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeImmediately123!
